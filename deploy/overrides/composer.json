{
  "name": "latestgovtjobs/automation",
  "type": "project",
  "description": "Code-first government recruitment monitoring and review system for LatestGovtJobs.co.in",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.0",
    "predis/predis": "^3.0",
    "symfony/dom-crawler": "^7.4|^8.0",
    "symfony/css-selector": "^7.4|^8.0",
    "spatie/pdf-to-text": "^1.54"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}